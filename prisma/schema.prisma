// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
  OUTSIDER
}

// ACTIVE: normal, assignable. DISABLED: no new duties, but record and
// history stay visible. DELETED: soft-delete -- hidden from normal lists,
// but the row stays (never hard-deleted) so past duty/order records that
// reference this staffId keep resolving instead of breaking a foreign key.
enum StaffStatus {
  ACTIVE
  DISABLED
  DELETED
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  password     String
  name         String
  role         Role
  designation  String?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @updatedAt @db.Timestamptz
  last_login_at  DateTime? @db.Timestamptz
}

model Service {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  abbreviation String   @unique
  is_active    Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  staff StaffService[]
}

model Staff {
  id                       Int       @id @default(autoincrement())
  name                     String
  place                    String
  contactNumber            String
  dob                      DateTime? @db.Date
  guardianName             String?
  relationshipWithGuardian String?
  guardianContactNumber    String?
  verifiedAddress          String?
  idProof                  String?
  idNumber                 String?
  bankAccountDetails       String?
  rating                   Int       @default(5)
  remarks                  String?
  status                   StaffStatus @default(ACTIVE)
  created_at               DateTime  @default(now()) @db.Timestamptz
  updated_at               DateTime  @updatedAt @db.Timestamptz

  services StaffService[]
}

// Join table for Staff <-> Service. Deliberately no is_active column here --
// a staff member currently offering a service is represented by the row's
// existence; removing it (not flagging it) means "they stopped." Whether the
// service itself is still offered at all lives on Service.is_active, checked
// via the join at read time -- never copied/cached onto this table.
model StaffService {
  staffId   Int
  serviceId Int
  staff     Staff   @relation(fields: [staffId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([staffId, serviceId])
}